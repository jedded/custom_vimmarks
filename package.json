{
  "name": "vim-marks-sidebar",
  "displayName": "Vim Marks Sidebar",
  "description": "Vim-style global marks (a-z, A-Z) grouped into projects, with a sidebar list, gutter letters and persistent storage. Designed to be driven by VSCodeVim key bindings.",
  "version": "0.3.2",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.88.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vimMarks",
          "title": "Marks",
          "icon": "media/marks.svg"
        }
      ]
    },
    "views": {
      "vimMarks": [
        {
          "id": "vimMarks.list",
          "name": "Marks"
        }
      ]
    },
    "commands": [
      {
        "command": "vimMarks.set",
        "title": "Vim Marks: Set Mark"
      },
      {
        "command": "vimMarks.jump",
        "title": "Vim Marks: Jump to Mark (line)"
      },
      {
        "command": "vimMarks.jumpExact",
        "title": "Vim Marks: Jump to Mark (exact position)"
      },
      {
        "command": "vimMarks.open",
        "title": "Vim Marks: Open Mark"
      },
      {
        "command": "vimMarks.toggleSort",
        "title": "Vim Marks: Toggle View (creation order / grouped by file)",
        "icon": "$(list-tree)"
      },
      {
        "command": "vimMarks.delete",
        "title": "Vim Marks: Delete Mark",
        "icon": "$(trash)"
      },
      {
        "command": "vimMarks.clear",
        "title": "Vim Marks: Delete All Marks in Current Project",
        "icon": "$(clear-all)"
      },
      {
        "command": "vimMarks.selectProject",
        "title": "Vim Marks: Select Project"
      },
      {
        "command": "vimMarks.switchProject",
        "title": "Vim Marks: Switch Project"
      },
      {
        "command": "vimMarks.newProject",
        "title": "Vim Marks: New Project",
        "icon": "$(add)"
      },
      {
        "command": "vimMarks.renameProject",
        "title": "Vim Marks: Rename Project",
        "icon": "$(edit)"
      },
      {
        "command": "vimMarks.deleteProject",
        "title": "Vim Marks: Delete Project",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "vimMarks.open",
          "when": "false"
        },
        {
          "command": "vimMarks.selectProject",
          "when": "false"
        },
        {
          "command": "vimMarks.delete",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "vimMarks.newProject",
          "when": "view == vimMarks.list",
          "group": "navigation@0"
        },
        {
          "command": "vimMarks.toggleSort",
          "when": "view == vimMarks.list",
          "group": "navigation@1"
        },
        {
          "command": "vimMarks.clear",
          "when": "view == vimMarks.list",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "vimMarks.delete",
          "when": "view == vimMarks.list && viewItem == mark",
          "group": "inline@0"
        },
        {
          "command": "vimMarks.renameProject",
          "when": "view == vimMarks.list && viewItem == project",
          "group": "inline@0"
        },
        {
          "command": "vimMarks.deleteProject",
          "when": "view == vimMarks.list && viewItem == project",
          "group": "inline@1"
        }
      ]
    },
    "keybindings": [
      {
        "key": "m a",
        "command": "vimMarks.set",
        "args": "a",
        "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
